   ]
  },
  {
   "kind": "slider-design-pleasure",
   "id": "anchor_main-points",
   "title": "Embodying the Antares Style",
   "intro": "",
   "items": [
    {
     "title": "Technology Serving Comfort and Pleasure",
     "text": "Powered by twin Mercury latest generation Verado V10 400 HP engines with an integrated joystick, the Antares 12 delivers an inspiring level of power and agility on the water. In order to meet all markets expectations, the Antares 12 is also available with triple Mercury Verado V8 300 HP engines. Exceptional visibility from either helm and an optional Seakeeper gyro give you the confidence to safely operate the boat in most weather conditions."
    },
    {
     "title": "Living in Harmony Aboard",
     "text": "Opening the three-leaf cockpit door transforms the salon and cockpit into an open space. Blending the cockpit into the wheelhouse lounge creates great flow from the aft of the Antares 12 forward. The safe walkways and the circulation area behind the engines makes for easy movement aboard."
    },
    {
     "title": "Sunny Getaways and the Joy of Boating",
     "text": "With its stylish side platform extending the cockpit, snorkelling and paddle board fans will enjoy easy access into and out of the water."
    }
   ],
