   "items": [
    {
     "title": "Flexible Sun & Shade Experience",
     "text": "A range of shading configurations enables owners to tailor their environment, achieving the ideal balance of sun, shade, and open-air freedom throughout the day."
    },
    {
     "title": "Enhanced Comfort at Anchor",
     "text": "By significantly reducing movement at anchor, the optional Seakeeper 3 gyro stabilization system enhances onboard comfort, creating a serene and enjoyable environment for relaxation."
    },
    {
     "title": "Designed for Day Trips & Weekends Away",
     "text": "Convertible living spaces, comfortable overnight accommodation, and thoughtful onboard amenities make the Gran Turismo 40 Open equally suited to spontaneous escapes and extended cruising."
    }
