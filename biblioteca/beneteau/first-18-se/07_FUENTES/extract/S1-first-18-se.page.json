  {
   "kind": "anchor_block_text_image-84452",
   "id": "anchor_block_text_image-84452",
   "title": "COMMUNITY",
   "intro": "International Owners Community and events calendar enable owners to challenge themselves on long-distance.\nOne Design challenges across the continent in a great company of supportive, like-minded sailors.",
   "items": [],
