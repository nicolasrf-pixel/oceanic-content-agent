   ]
  },
  {
   "kind": "interior-design",
   "id": null,
   "title": "INTERIOR DESIGN",
   "intro": "Bordering on a sport cruiser, the Flyer 10 provides unique living space. The two double berths, divided among a saloon cabin and a mid-cabin, mean that you can spend a few nights on board.The boat is truly comfortable with a proper shower room, with a head separate from the shower, in addition to a large storage space at the foot of the stairway.Two long hull windows pleasantly bathe the interior in light.",
   "items": [],
