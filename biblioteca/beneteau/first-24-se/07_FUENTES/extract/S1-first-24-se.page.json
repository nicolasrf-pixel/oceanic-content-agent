 "sections": [
  {
   "kind": "text-images-slider",
   "id": "SAILING EXPERIENCE",
   "title": "SAILING EXPERIENCE",
   "intro": "First 24 SE is a true pocket-rocket, defined by a racing background of the design team. Incredible sail area to displacement ratio ensures fast sailing in strong and light wind conditions. Downwind planing in the stronger breezes is a real blast and pure joy because of the stable hull, deep, ballasted keel and twin rudders, which give you complete control. You will enjoy sailing in lighter conditions, too, when she'll react to the slightest wind gusts and easily reach the wind-speeds. Spacious, open and carefully thought-out cockpit ergonomics works in solo, double-handed or fully-crewed setup and guarantee easy handling and comfortable sailing, no matter if you're on relaxed afternoon sailing or racing on one-design regattas.",
   "items": [],
   "images": [
