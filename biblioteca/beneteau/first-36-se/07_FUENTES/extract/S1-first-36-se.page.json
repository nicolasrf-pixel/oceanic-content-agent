  {
   "kind": "text-images-slider",
   "id": "A Passionate Sailing Community ",
   "title": "A Passionate Sailing Community",
   "intro": "First SE is more than just a boat—it’s a mindset. She brings together a tight-knit community of dedicated sailors who live for adventure, competition, and the simple joy of sailing. With the First 36 SE, sailing isn’t just a sport; it’s a way of life.",
   "items": [],
   "images": [
    "https://www.beneteau.com/sites/default/files/2025-06/FIRST-36-SE-illu-slider-1440x810-2.jpg"
   ]
  },
  {
   "kind": "slider-design-pleasure",
   "id": "anchor_main-points",
   "title": "Why First 36 SE ?",
   "intro": "",
   "items": [
    {
     "title": "The Ultimate Planing Experience",
     "text": "Feel the exhilaration of high-performance planing, where speed and control unite. With every gust, the First 36 SE accelerates effortlessly, offering an unmatched connection to the elements— pure, wind-powered sailing joy."
    },
    {
     "title": "Optimized for ORC Racing",
     "text": "The First 36 SE has been meticulously engineered by a world-class team, including Samuel Manuard and Maurizio Cossutti, to maximize ORC racing potential. Every aspect—from hull shape to cockpit layout, keel design, and displacement—has been refined for speed, balance, and an improved handicap rating."
    },
    {
     "title": "Functionality Meets Performance",
     "text": "While built for dynamic sailors, the First 36 SE retains the practical functionality of the original First 36. Her optimized cockpit and interior offer all the essentials for life onboard, making her an excellent choice for both competitive racing and adventure cruising."
    },
    {
     "title": "Unrivaled Handling",
     "text": "Constructed with a fully cored, vacuum-infused hull, deck, bulkheads, and interior components, the First 36 SE is exceptionally light and stiff. She is 400 kg (881 pounds) lighter than the standard First 36, thanks to innovative material optimization, ensuring superior speed and handling."
    }
   ],
