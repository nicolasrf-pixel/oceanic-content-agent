__pycache__/
*.pyc
.cache/
# Copias web de imágenes: viven en el ZIP que se sube a Drive (se regeneran con `python -m oceanic media --cdn`).
biblioteca/**/05_MULTIMEDIA/IMAGENES/*/
dist/*.zip
# Credenciales locales: nunca se versionan.
.env
*.env

# Fotos de usados: van en el ZIP, no en git
usados/*/fotos/

# Restos de wrangler (pruebas locales de Cloudflare)
sitio/node_modules/
sitio/.wrangler/
.dev.vars

# Fotos del sitio: se descargan en el build de Cloudflare (sitio/scripts/build.sh), no se versionan
sitio/assets/img/modelos/
sitio/assets/img/usados/
traducciones/.lote-*.json
