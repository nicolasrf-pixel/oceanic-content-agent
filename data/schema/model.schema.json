{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceanic-content-agent/schema/model.schema.json",
  "title": "Model (Fase 2 — aún no poblado)",
  "description": "Registro de un modelo dentro de una familia dentro de una marca. Definido ahora (PASO 4) para que el esquema exista antes del inventario masivo de la Fase 2; data/models/ permanece vacío hasta que ese inventario sea aprobado. Ver CLAUDE.md secciones 7, 9, 11, 16.",
  "type": "object",
  "required": [
    "model_id",
    "brand_id",
    "family",
    "model_name",
    "category",
    "lifecycle_status",
    "confidence_level",
    "sources",
    "verified_at",
    "last_updated",
    "status_pipeline"
  ],
  "additionalProperties": false,
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador normalizado kebab-case, ej. 'axopar-37-xc'."
    },
    "brand_id": {
      "type": "string",
      "description": "Referencia a brand_id en data/brands/master-inventory.json."
    },
    "family": {
      "type": "string",
      "description": "Familia/línea dentro de la marca, ej. 'Axopar 37'."
    },
    "model_name": {
      "type": "string",
      "description": "Nombre completo del modelo tal como lo usa el fabricante, ej. 'Axopar 37 XC'."
    },
    "variants": {
      "type": "array",
      "description": "Variantes/configuraciones (motorización, layout, paquete). Nunca se promueven a modelo independiente salvo tratamiento explícito del fabricante (CLAUDE.md sección 16).",
      "items": {
        "type": "object",
        "required": ["variant_name", "confidence_level"],
        "additionalProperties": false,
        "properties": {
          "variant_name": { "type": "string" },
          "description": { "type": "string" },
          "confidence_level": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "notes": { "type": "string" }
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "motor",
        "sail",
        "power_catamaran",
        "sail_catamaran",
        "dinghy",
        "one_design",
        "UNKNOWN"
      ]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["CURRENT", "NEW", "DISCONTINUED", "ANNOUNCED", "UNCONFIRMED"],
      "description": "CLAUDE.md sección 11. Un modelo DISCONTINUED se conserva, nunca se borra."
    },
    "model_year": {
      "type": ["string", "null"],
      "description": "Año / model year cuando corresponda. null si no aplica o UNKNOWN."
    },
    "manufacturer_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "oceanic_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "confidence_level": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "specifications": {
      "type": "object",
      "description": "Capa de DATOS objetivos únicamente. Nunca contenido editorial (CLAUDE.md sección 12). Cada campo admite el valor literal 'UNKNOWN' o 'UNCONFIRMED' en vez de un número cuando no hay dato confirmado.",
      "additionalProperties": true
    },
    "discrepancies": {
      "type": "array",
      "description": "Contradicciones entre fuentes para algún campo, con ambos valores conservados (CLAUDE.md sección 14).",
      "items": {
        "type": "object",
        "required": ["field", "values"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "source"],
              "properties": {
                "value": {},
                "source": { "$ref": "./source.schema.json" }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./source.schema.json" }
    },
    "verified_at": { "type": "string", "format": "date" },
    "last_updated": { "type": "string", "format": "date" },
    "status_pipeline": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "MAPPED",
        "VALIDATED",
        "RESEARCHED",
        "CONTENT_READY",
        "ASSETS_READY",
        "PAGE_READY",
        "PUBLISHED"
      ]
    },
    "notes": { "type": "string" }
  }
}
